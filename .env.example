# Must be set in Vercel project environment, never commit real values.
DATABASE_URL=<postgresql-external-connection-url>
ADMIN_KEY=<strong-random-32-plus-character-secret>
PORT=3000
BASE_PATH=/
# Flask auth/saved-UID service requires separately hosted persistent backend.
JWT_SECRET=<strong-random-jwt-secret>
FLASK_BACKEND_URL=https://<persistent-flask-service>.onrender.com
FLASK_DATABASE_URL=<postgresql-internal-connection-url>
SITE_ORIGIN=https://oparetor.xerotic.top
PRODUCTION=true
