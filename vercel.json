{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/uid-web build",
  "outputDirectory": "artifacts/uid-web/dist/public",
  "rewrites": [
    {
      "source": "/fb-api/:path*",
      "destination": "/api/flask?path=:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
